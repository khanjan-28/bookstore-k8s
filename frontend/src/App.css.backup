/* ===================================================
   ONLINE BOOK STORE
   Premium UI
=================================================== */

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:"Poppins",sans-serif;
}

html{
    scroll-behavior:smooth;
}

body{
    background:#eef3ff;
}

.app{

    min-height:100vh;

    background:
    linear-gradient(
    135deg,
    #eef4ff,
    #dbeafe,
    #ffffff
    );

    color:#1e293b;

    transition:.4s;

}

/* DARK MODE */

.app.dark{

    background:
    linear-gradient(
    135deg,
    #0f172a,
    #1e293b,
    #111827
    );

    color:#fff;

}

/* NAVBAR */

.navbar{

    display:flex;

    justify-content:space-between;

    align-items:center;

    padding:25px 45px;

    background:

    rgba(255,255,255,.75);

    backdrop-filter:blur(18px);

    box-shadow:

    0 10px 30px rgba(0,0,0,.08);

    position:sticky;

    top:0;

    z-index:999;

}

.app.dark .navbar{

    background:

    rgba(15,23,42,.85);

}

.navbar h1{

    font-size:34px;

    font-weight:700;

}

.navbar span{

    color:#64748b;

}

.app.dark .navbar span{

    color:#cbd5e1;

}

/* THEME AREA */

.themeArea{

    display:flex;

    align-items:center;

    gap:15px;

}

.themeStatus{

    background:#2563eb;

    color:white;

    padding:8px 18px;

    border-radius:50px;

    font-weight:600;

}

.themeBtn{

    border:none;

    padding:12px 22px;

    border-radius:50px;

    background:

    linear-gradient(
    135deg,
    #2563eb,
    #06b6d4
    );

    color:white;

    cursor:pointer;

    font-weight:bold;

    transition:.3s;

}

.themeBtn:hover{

    transform:translateY(-3px);

}

/* CONTAINER */

.container{

    width:92%;

    margin:auto;

    padding:40px 0;

}

/* DASHBOARD */

.dashboard{

    display:grid;

    grid-template-columns:

    repeat(auto-fit,minmax(220px,1fr));

    gap:25px;

    margin-bottom:35px;

}

.card{

    background:white;

    border-radius:22px;

    padding:30px;

    text-align:center;

    box-shadow:

    0 15px 35px rgba(0,0,0,.08);

    transition:.3s;

}

.app.dark .card{

    background:#1f2937;

}

.card:hover{

    transform:

    translateY(-8px);

}

.icon{

    font-size:45px;

    margin-bottom:15px;

}

.card h2{

    font-size:34px;

}

.card p{

    margin-top:8px;

    opacity:.8;

}
/* ==========================================
   SEARCH BAR
========================================== */

.search-bar{

    display:flex;

    gap:15px;

    align-items:center;

    position:relative;

    overflow:visible;

    background:rgba(255,255,255,.8);

    backdrop-filter:blur(15px);

    padding:22px;

    border-radius:20px;

    box-shadow:0 10px 25px rgba(0,0,0,.08);

    margin-bottom:35px;

}
.app.dark .search-bar{

    background:rgba(31,41,55,.9);

}

.search-bar input{

    flex:1;

    height:55px;

    border:1px solid #dbe2ea;

    border-radius:50px;

    padding:0 22px;

    background:white;

    color:#111827;

    font-size:16px;

}

.search-bar input::placeholder{

    color:#94a3b8;

}

.app.dark .search-bar input{

    background:#374151;

    color:white;

    border:1px solid #4b5563;

}

.app.dark .search-bar input::placeholder{

    color:#cbd5e1;

}

.search-bar button{

    height:55px;

    padding:0 28px;

    border:none;

    border-radius:50px;

    cursor:pointer;

    font-weight:700;

    color:white;

    background:linear-gradient(135deg,#2563eb,#06b6d4);

    transition:.3s;

}

.search-bar button:hover{

    transform:translateY(-2px);

    box-shadow:0 8px 18px rgba(37,99,235,.35);

}

.clear-btn{

    background:linear-gradient(135deg,#ef4444,#dc2626)!important;

}
.search-bar select{

height:55px;

padding:0 18px;

border:1px solid #dbe2ea;

border-radius:50px;

background:linear-gradient(135deg,#eef2ff,#dbeafe);

color:#1e3a8a;

font-size:15px;

font-weight:600;

cursor:pointer;

outline:none;

transition:.3s;

min-width:190px;

}


.search-bar select:hover{

transform:translateY(-2px);

box-shadow:0 8px 18px rgba(37,99,235,.25);

}


.search-bar select:focus{

border-color:#2563eb;

box-shadow:0 0 0 4px rgba(37,99,235,.18);

}


.search-bar select option{

background:white;

color:#111827;

}
.app.dark .search-bar select{

background:linear-gradient(135deg,#374151,#1f2937);

color:white;

border:1px solid #4b5563;

}


.app.dark .search-bar select option{

background:#1f2937;

color:white;

}

/* ==========================================
   BOOK FORM
========================================== */

.book-form{

    margin:40px 0;

    position: relative;

    z-index: 1;

}

.form-header{

    text-align:center;

    margin-bottom:25px;

}

.form-header h2{

    font-size:32px;

    margin-bottom:8px;

}

.form-header p{

    color:#64748b;

}

.app.dark .form-header p{

    color:#cbd5e1;

}

.book-form form{

    background:rgba(255,255,255,.85);

    backdrop-filter:blur(18px);

    padding:35px;

    border-radius:22px;

    box-shadow:0 12px 30px rgba(0,0,0,.08);

}

.app.dark .book-form form{

    background:rgba(31,41,55,.9);

}

.input-group{

    margin-bottom:20px;

}

.input-group label{

    display:block;

    font-weight:600;

    margin-bottom:8px;

}

.input-group input,
.input-group textarea{

    width:100%;

    padding:15px;

    border-radius:14px;

    border:1px solid #dbe2ea;

    outline:none;

    font-size:15px;

    color:#111827;

    background:white;

    transition:.3s;

}

.input-group textarea{

    resize:vertical;

}

.input-group input:focus,
.input-group textarea:focus{

    border-color:#2563eb;

    box-shadow:0 0 0 4px rgba(37,99,235,.15);

}

.app.dark .input-group input,
.app.dark .input-group textarea{

    background:#374151;

    color:white;

    border:1px solid #4b5563;

}

.app.dark .input-group input::placeholder,
.app.dark .input-group textarea::placeholder{

    color:#cbd5e1;

}

/* ==========================================
   ADD BOOK BUTTON
========================================== */
.addBookBtn{

  background:#2563eb;

  color:white;

  border:none;

  padding:12px 28px;

  border-radius:12px;

  font-size:16px;

  font-weight:600;

  cursor:pointer;

  transition:.3s;

  display:inline-flex;

  align-items:center;

  justify-content:center;

  width:auto;

}


.addBookBtn:hover{

  transform:translateY(-2px);

}

/* ==========================================
   BOOK LIST
========================================== */

.book-list{

    margin-top:45px;

}

.tableHeader{

    display:flex;

    justify-content:space-between;

    align-items:center;

    margin-bottom:25px;

}

.tableHeader h2{

    font-size:30px;

    font-weight:700;

}

.tableHeader span{

    background:linear-gradient(135deg,#2563eb,#06b6d4);

    color:white;

    padding:8px 18px;

    border-radius:50px;

    font-weight:600;

}

/* ==========================================
   TABLE
========================================== */

.tableContainer{

    overflow-x:auto;

    border-radius:20px;

    box-shadow:0 15px 35px rgba(0,0,0,.08);
    
     position:relative;
}

table{

    width:100%;

    border-collapse:collapse;

    background:white;

}

.app.dark table{

    background:#1f2937;

}

th{

    background:linear-gradient(135deg,#2563eb,#1d4ed8);

    color:white;

    padding:18px;

    text-align:center;

    font-size:15px;

    font-weight:700;

}

td{

    padding:18px;

    text-align:center;

    border-bottom:1px solid #e5e7eb;

    color:#334155;

}

.app.dark td{

    color:#f8fafc;

    border-bottom:1px solid #374151;

}

tbody tr{

    transition:.25s;

}

tbody tr:hover{

    background:#f8fafc;

    transform:scale(1.01);

}

.app.dark tbody tr:hover{

    background:#374151;

}

/* ==========================================
   BADGES
========================================== */

.categoryBadge{

    display:inline-block;

    background:#2563eb;

    color:white;

    padding:7px 14px;

    border-radius:50px;

    font-size:13px;

    font-weight:700;

}

.priceBadge{

    display:inline-block;

    background:#16a34a;

    color:white;

    padding:7px 14px;

    border-radius:50px;

    font-size:13px;

    font-weight:700;

}

/* ==========================================
   DELETE BUTTON
========================================== */

.delete-btn{

    background:linear-gradient(135deg,#ef4444,#dc2626);

    color:white;

    border:none;

    padding:12px 22px;

    border-radius:12px;

    cursor:pointer;

    font-weight:bold;

    transition:.35s;

}

.delete-btn:hover{

    transform:translateY(-3px);

    box-shadow:0 15px 30px rgba(239,68,68,.35);

}
/* ==========================================
   EMPTY STATE
========================================== */

.noBooks{

    text-align:center;

    padding:60px 30px;

    border-radius:20px;

    background:rgba(255,255,255,.85);

    box-shadow:0 10px 30px rgba(0,0,0,.08);

}

.app.dark .noBooks{

    background:#1f2937;

}

.noBooks h3{

    font-size:28px;

    margin-bottom:10px;

}

.noBooks p{

    color:#64748b;

}

.app.dark .noBooks p{

    color:#cbd5e1;

}
/* ==================================================
   FOOTER
================================================== */

footer{

    margin-top:50px;

    padding:25px;

    text-align:center;

    font-size:15px;

    color:#64748b;

}

.app.dark footer{

    color:#cbd5e1;

}

/* ==================================================
   INPUT FOCUS
================================================== */

input:focus,
textarea:focus,
select:focus{

    outline:none;

    border-color:#2563eb;

    box-shadow:0 0 0 4px rgba(37,99,235,.18);

}

/* ==================================================
   BUTTON ANIMATION
================================================== */

button{

    transition:.30s ease;

}

button:hover{

    transform:translateY(-3px);

}

button:active{

    transform:scale(.96);

}

/* ==================================================
   CARD ANIMATION
================================================== */

.card{

    transition:.35s ease;

}

.card:hover{

    transform:translateY(-8px);

    box-shadow:0 20px 40px rgba(0,0,0,.15);

}

/* ==================================================
   TABLE ANIMATION
================================================== */

tbody tr{

    transition:.25s;

}

tbody tr:hover{

    transform:scale(1.01);

}

/* ==================================================
   SCROLLBAR
================================================== */

::-webkit-scrollbar{

    width:10px;

}

::-webkit-scrollbar-track{

    background:#e5e7eb;

}

::-webkit-scrollbar-thumb{

    background:#2563eb;

    border-radius:20px;

}

::-webkit-scrollbar-thumb:hover{

    background:#1d4ed8;

}

/* ==================================================
   DARK MODE SCROLLBAR
================================================== */

.app.dark ::-webkit-scrollbar-track{

    background:#1f2937;

}

.app.dark ::-webkit-scrollbar-thumb{

    background:#3b82f6;

}

/* ==================================================
   RESPONSIVE
================================================== */

@media (max-width:992px){

.navbar{

    flex-direction:column;

    gap:18px;

    text-align:center;

}

.dashboard{

    grid-template-columns:repeat(2,1fr);

}

.search-bar{

    flex-wrap:wrap;
    
    position: relative;

    z-index: 1000;
}

}

.search-bar input{

    width:100%;

}

.tableHeader{

    flex-direction:column;

    gap:12px;

}


@media (max-width:768px){

.container{

    width:95%;

}

.dashboard{

    grid-template-columns:1fr;

}

.book-form form{

    padding:22px;

}

.search-bar{

    flex-direction:column;

}

.search-bar button{

    width:100%;

}

.themeBtn{

    width:100%;

}

th,
td{

    padding:12px;

    font-size:14px;

}

}

@media (max-width:480px){

.navbar h1{

    font-size:26px;

}

.card h2{

    font-size:28px;

}

.tableHeader h2{

    font-size:24px;

}

}
/* ==========================
   ROUND THEME BUTTON
========================== */

.themeToggle{

    width:60px;
    height:60px;

    border:none;
    border-radius:50%;

    display:flex;
    justify-content:center;
    align-items:center;

    font-size:28px;

    cursor:pointer;

    background:rgba(255,255,255,.25);
    backdrop-filter:blur(15px);

    color:#1e3a8a;

    box-shadow:0 10px 25px rgba(0,0,0,.15);

    transition:.35s;

}

.themeToggle:hover{

    transform:scale(1.08) rotate(20deg);

}

.app.dark .themeToggle{

    background:rgba(255,255,255,.08);

    color:#facc15;

}
/* ===========================================
           DELETE POPUP
=========================================== */

.popupOverlay {

    position: fixed;

    top: 0;
    left: 0;

    width: 100vw;
    height: 100vh;

    background: rgba(0,0,0,0.5);

    display: flex;

    justify-content: center;

    align-items: center;

    z-index: 99999;

}

.popup-box {
    background:white;
    width:400px;
    max-width:90%;

    padding:30px;
    border-radius:15px;

    box-shadow:0 10px 30px rgba(0,0,0,0.3);

}
.popup {

    background: white;

    width: 400px;

    max-width: 90%;

    padding: 30px;

    border-radius: 20px;

    box-shadow: 0 20px 50px rgba(0,0,0,.3);

}
@keyframes popup {

from{

opacity:0;

transform:translateY(25px) scale(.95);

}

to{

opacity:1;

transform:translateY(0) scale(1);

}

}
.popup select{

    width:100%;

    padding:14px 16px;

    margin-bottom:15px;

    border:1px solid #d1d5db;

    border-radius:10px;

    font-size:16px;

    outline:none;

    transition:.3s;

}

.popup select:focus{

    border-color:#2563eb;

    box-shadow:0 0 0 3px rgba(37,99,235,.15);

}

.popup h2{
  text-align:center;
  margin-bottom:20px;
}


.popup input,
.popup select,
.popup textarea{

width:100%;

padding:14px 16px;

margin-top:14px;

border:1px solid #ddd;

border-radius:10px;

font-size:16px;

outline:none;

transition:.3s;

box-sizing:border-box;

}

.popup input:focus,
.popup select:focus,
.popup textarea:focus{

border-color:#2563eb;

box-shadow:0 0 0 4px rgba(37,99,235,.15);

}

.popup textarea{

height:100px;
resize:none;

}
.popupButtons{
    display:flex;
    justify-content:space-between;
    align-items:center;
    gap:16px;
    margin-top:30px;
    width:100%;
}
.popupButtons button{
    flex:1;
    height:52px;
    padding:0;
    margin:0;
    border:none;
    border-radius:12px;
    font-size:16px;
    font-weight:600;
    display:flex;
    justify-content:center;
    align-items:center;
    white-space:nowrap;
    box-sizing:border-box;
}

.confirmBtn,
.cancelBtn{
    width:200px;
    height:56px;
    border:none;
    border-radius:12px;
    font-size:18px;
    font-weight:600;
    cursor:pointer;

    display:flex;
    justify-content:center;
    align-items:center;

    padding:0;
    margin:0;
    box-sizing:border-box;

    transition:.3s;
}

/* Add Book */

.confirmBtn{
    background:#2563eb;
    color:#fff;
}

.confirmBtn:hover{
    background:#1d4ed8;
}

.cancelBtn{
    background:#ef4444;
    color:#fff;
}

.cancelBtn:hover{
    background:#dc2626;
}
/* Dark Mode */

.app.dark .popup{

    background:#1e293b;

}

.app.dark .popup h3{

    color:white;

}

.app.dark .popup p{

    color:#cbd5e1;

}

.app.dark .cancelBtn{

    background:#334155;

    color:white;

}

/* Animation */

@keyframes fadeIn{

from{

opacity:0;

}

to{

opacity:1;

}

}

@keyframes popupScale{

from{

transform:scale(.8);

opacity:0;

}

to{

transform:scale(1);

opacity:1;

}

}
/* ============================
     POPUP UPGRADE
============================ */

.popup{

    position:relative;

    overflow:hidden;

}

.closePopup{

    position:absolute;

    right:15px;

    top:15px;

    width:40px;

    height:40px;

    border:none;

    border-radius:50%;

    cursor:pointer;

    background:#f1f5f9;

    font-size:18px;

    transition:.3s;

}

.closePopup:hover{

    transform:rotate(90deg);

    background:#ef4444;

    color:white;

}

.popupIcon{

    width:90px;

    height:90px;

    margin:auto;

    margin-bottom:20px;

    border-radius:50%;

    display:flex;

    justify-content:center;

    align-items:center;

    font-size:42px;

    background:linear-gradient(135deg,#fee2e2,#fecaca);

}

.app.dark .popupIcon{

    background:#7f1d1d;

}
/* ==========================
      TOAST NOTIFICATION
========================== */


.toast{

position:fixed;

top:30px;

right:30px;

padding:16px 25px;

border-radius:14px;

font-size:16px;

font-weight:600;

color:white;

z-index:9999;

animation:slideToast .4s ease;

box-shadow:0 15px 35px rgba(0,0,0,.2);

}



.toast.success{

background:linear-gradient(
135deg,
#22c55e,
#16a34a
);

}



.toast.error{

background:linear-gradient(
135deg,
#ef4444,
#dc2626
);

}



@keyframes slideToast{


from{

transform:translateX(120%);

opacity:0;

}


to{

transform:translateX(0);

opacity:1;

}


}



.app.dark .toast{

box-shadow:
0 15px 40px rgba(0,0,0,.6);

}
/* Loading Spinner */

.loader{

position:fixed;

top:90px;

right:30px;


background:#2563eb;

color:white;

padding:15px 25px;

border-radius:12px;


font-weight:600;


z-index:9999;


animation:pulse 1s infinite;

}



@keyframes pulse{


0%{

opacity:1;

}


50%{

opacity:.5;

}


100%{

opacity:1;

}


}
/* Disabled Button */

button:disabled{

  opacity:0.5;

  cursor:not-allowed;

}
.search-bar select{

padding:12px 16px;

border-radius:12px;

border:1px solid #ddd;

background:white;

cursor:pointer;

min-width:180px;

font-size:15px;

font-weight:500;

}
/* ---------- Custom Category Dropdown ---------- */

.customDropdown{

position:relative;

min-width:220px;

}

.dropdownBtn{

width:100%;

height:55px;

border:none;

border-radius:50px;

padding:0 22px;

cursor:pointer;

font-size:15px;

font-weight:600;

display:flex;

align-items:center;

justify-content:space-between;

background:linear-gradient(135deg,#2563eb,#06b6d4);

color:white;

transition:.3s;

box-shadow:0 8px 20px rgba(37,99,235,.25);

}

.dropdownBtn:hover{

transform:translateY(-2px);

box-shadow:0 12px 25px rgba(37,99,235,.35);

}

.dropdownMenu{

position:absolute;

top:65px;

left:0;

width:240px;

background:white;

border-radius:18px;

box-shadow:0 18px 40px rgba(0,0,0,.18);

z-index:99999;

max-height:300px;

overflow-y:auto;

overflow-x:hidden;

}
.dropdownItem{

padding:15px 18px;

cursor:pointer;

font-size:15px;

font-weight:500;

transition:.25s;

}

.dropdownItem:hover{

background:#eff6ff;

color:#2563eb;

padding-left:24px;

}

@keyframes dropdown{

from{

opacity:0;

transform:translateY(-10px);

}

to{

opacity:1;

transform:translateY(0);

}

}
.app.dark .dropdownBtn{

background:linear-gradient(135deg,#374151,#111827);

color:white;

}

.app.dark .dropdownMenu{

background:#1f2937;

}

.app.dark .dropdownItem{

color:white;

}

.app.dark .dropdownItem:hover{

background:#374151;

color:#60a5fa;

}
@media(max-width:768px){

.customDropdown{

width:100%;

}

.dropdownBtn{

width:100%;

}

.dropdownMenu{

width:100%;

}

}
/* ===========================
   CATEGORY SELECT
=========================== */

.categorySelect{

    min-width:220px;

    height:55px;

    padding:0 18px;

    border:none;

    border-radius:50px;

    outline:none;

    cursor:pointer;

    font-size:15px;

    font-weight:600;

    color:white;

    background:linear-gradient(135deg,#2563eb,#06b6d4);

    box-shadow:0 8px 20px rgba(37,99,235,.25);

    transition:.3s;

    appearance:none;

    -webkit-appearance:none;

    -moz-appearance:none;

}

.categorySelect:hover{

    transform:translateY(-2px);

    box-shadow:0 12px 25px rgba(37,99,235,.35);

}

.categorySelect option{

    background:white;

    color:#111827;

    font-weight:500;

}

.app.dark .categorySelect{

    background:linear-gradient(135deg,#374151,#111827);

    color:white;

}

.app.dark .categorySelect option{

    background:#1f2937;

    color:white;

}
/* Empty State */

.emptyState{

text-align:center;

padding:60px;

background:white;

border-radius:25px;

box-shadow:0 15px 35px rgba(0,0,0,.08);

animation:fadeIn .5s ease;

}


.emptyIcon{

font-size:60px;

margin-bottom:20px;

}


.emptyState h2{

font-size:28px;

margin-bottom:10px;

}


.emptyState p{

opacity:.6;

font-size:16px;

}
/* Table Row Animation */

tbody tr{

animation:slideUp .4s ease;

transition:.3s ease;

}


tbody tr:hover{

background:#f8fafc;

transform:scale(1.01);

}



/* Animation */

@keyframes slideUp{

from{

opacity:0;

transform:translateY(20px);

}


to{

opacity:1;

transform:translateY(0);

}

}
.categoryBadge{

display:inline-block;

padding:6px 14px;

border-radius:20px;

background:#eef2ff;

color:#4338ca;

font-size:13px;

font-weight:600;

}


.categoryBadge:hover{

transform:scale(1.05);

}
.priceBadge{

display:inline-block;

padding:6px 14px;

border-radius:20px;

background:#dcfce7;

color:#166534;

font-weight:700;

font-size:14px;

}
.edit-btn,
.delete-btn{

border:none;

padding:8px 14px;

border-radius:10px;

cursor:pointer;

font-weight:600;

transition:.3s ease;

margin-right:8px;

}


/* Edit Button */

.edit-btn{

background:#2563eb;

color:white;

}


/* Delete Button */

.delete-btn{

background:#dc2626;

color:white;

}



/* Hover Effect */

.edit-btn:hover,
.delete-btn:hover{

transform:translateY(-3px) scale(1.05);

box-shadow:0 8px 15px rgba(0,0,0,.15);

}


/* Individual hover colors */

.edit-btn:hover{

background:#1d4ed8;

}


.delete-btn:hover{

background:#b91c1c;

}
.popup{

animation:popupShow .3s ease;

}


@keyframes popupShow{

from{

opacity:0;

transform:scale(.8);

}


to{

opacity:1;

transform:scale(1);

}

}
/* Mobile Responsive */

@media(max-width:768px){


.container{

padding:15px;

}


/* Table Mobile Scroll */

.tableContainer{

overflow-x:auto;

}


/* Table size */

table{

min-width:900px;

}


/* Buttons */

.edit-btn,
.delete-btn{

padding:7px 10px;

font-size:13px;

}


/* Popup */

.popup{

width:90%;

padding:25px;

}


/* Popup heading */

.popup h2{

font-size:22px;

}


/* Inputs */

.popup input,
.popup textarea{

width:100%;

font-size:14px;

}



}
/* =====================
   Dark Mode Polish
===================== */


/* Table */

.app.dark table{

background:#111827;

color:white;

}


.app.dark th{

background:#1f2937;

color:white;

}


.app.dark td{

color:#e5e7eb;

border-color:#374151;

}



/* Row Hover */

.app.dark tbody tr:hover{

background:#1f2937;

}



/* Category Badge */

.app.dark .categoryBadge{

background:#312e81;

color:#c7d2fe;

}



/* Price Badge */

.app.dark .priceBadge{

background:#064e3b;

color:#bbf7d0;

}



/* Edit Button */

.app.dark .edit-btn{

background:#1d4ed8;

color:white;

}



/* Delete Button */

.app.dark .delete-btn{

background:#991b1b;

color:white;

}



/* Popup */

.app.dark .popup{

background:#1f2937;

color:white;

}



/* Popup Inputs */

.app.dark .popup input,
.app.dark .popup textarea{

background:#111827;

color:white;

border:1px solid #374151;

}



/* Placeholder */

.app.dark input::placeholder,
.app.dark textarea::placeholder{

color:#9ca3af;

}



/* Empty State */

.app.dark .emptyState{

background:#1f2937;

color:white;

}
.errorBox{

margin:20px 0;

padding:20px;

background:#fee2e2;

color:#991b1b;

border-radius:15px;

text-align:center;

font-weight:600;

}


.errorBox button{

margin-left:15px;

padding:8px 15px;

border:none;

border-radius:8px;

background:#dc2626;

color:white;

cursor:pointer;

}
.pagination{

display:flex;

justify-content:center;

gap:10px;

margin:30px 0;

}


.pagination button{

padding:10px 15px;

border:none;

border-radius:8px;

cursor:pointer;

background:#eee;

}


.pagination button:hover{

transform:translateY(-2px);

}


.activePage{

background:#2563eb !important;

color:white;

}


.pagination button:disabled{

opacity:.5;

cursor:not-allowed;

}
.sortBox{

display:flex;

align-items:center;

gap:15px;

margin:20px 0;

}


.sortBox label{

font-weight:600;

}


.sortBox select{

padding:10px 15px;

border-radius:10px;

border:1px solid #ddd;

font-size:15px;

cursor:pointer;

}
.addBookSection{

  margin:30px 0;

  display:flex;

  justify-content:flex-start;

}


.addBookBtn{

background:#2563eb;

color:white;

border:none;

padding:14px 25px;

border-radius:12px;

font-size:16px;

font-weight:600;

cursor:pointer;

transition:.3s;

}



.addBookBtn:hover{

transform:translateY(-2px);

}



.formWrapper{

margin-top:25px;

padding:30px;

border-radius:20px;

background:white;

box-shadow:0 15px 35px rgba(0,0,0,.08);

animation:slideDown .3s ease;

}



.cancelBtn{

margin-top:15px;

padding:10px 20px;

border:none;

border-radius:10px;

background:#ef4444;

color:white;

cursor:pointer;

}



@keyframes slideDown{

from{

opacity:0;

transform:translateY(-20px);

}


to{

opacity:1;

transform:translateY(0);

}

}
.app.dark .formWrapper{

background:#1f2937;

color:white;

}


.app.dark .formWrapper input,
.app.dark .formWrapper textarea,
.app.dark .formWrapper select{

background:#111827;

color:white;

border:1px solid #374151;

}
.bookHeader{

display:flex;

align-items:center;

justify-content:space-between;

margin:30px 50px;

}


.sortBox{

display:flex;

align-items:center;

gap:15px;

background:white;

padding:12px 18px;

border-radius:15px;

box-shadow:0 8px 20px rgba(0,0,0,.08);

}


.sortBox label{

font-size:16px;

font-weight:700;

color:#24324a;

}


.sortBox select{

border:none;

outline:none;

background:#f3f7ff;

padding:12px 35px 12px 15px;

border-radius:12px;

font-size:15px;

cursor:pointer;

}


.addBookBtn{

background:#2563eb;

color:white;

border:none;

padding:12px 22px;

border-radius:14px;

font-size:16px;

font-weight:700;

cursor:pointer;

box-shadow:0 10px 20px rgba(37,99,235,.25);

transition:.3s;

}


.addBookBtn:hover{

transform:translateY(-3px);

background:#1d4ed8;

}
.addBtn{
    background:#2563eb;
    color:white;
}

.addBtn:hover{
    background:#1d4ed8;
    transform:translateY(-2px);
}
/* ================= LOGIN PAGE ================= */

.loginContainer{
    min-height:100vh;
    display:flex;
    justify-content:center;
    align-items:center;
    background:linear-gradient(135deg,#2563eb,#1e3a8a);
}

.loginCard{
    width:380px;
    background:#fff;
    padding:40px;
    border-radius:20px;
    box-shadow:0 20px 50px rgba(0,0,0,.2);
    text-align:center;
}

.loginCard h1{
    margin-bottom:10px;
    color:#2563eb;
}

.loginCard p{
    color:#666;
    margin-bottom:25px;
}

.loginCard input{
    width:100%;
    padding:14px;
    margin-bottom:15px;
    border:1px solid #ddd;
    border-radius:10px;
    font-size:15px;
    box-sizing:border-box;
}

.loginCard button{
    width:100%;
    padding:14px;
    border:none;
    border-radius:10px;
    background:#2563eb;
    color:white;
    font-size:16px;
    font-weight:bold;
    cursor:pointer;
    transition:.3s;
}

.loginCard button:hover{
    background:#1d4ed8;
}

/* ================= LOGOUT BUTTON ================= */

.logoutBtn{
    margin-left:15px;
    background:#ef4444;
    color:white;
    border:none;
    padding:10px 18px;
    border-radius:10px;
    cursor:pointer;
    font-weight:600;
    transition:.3s;
}

.logoutBtn:hover{
    background:#dc2626;
}
.bookInfo{
  display:flex;
  align-items:center;
  gap:12px;
}

.bookCover{
  width:50px;
  height:70px;
  object-fit:cover;
  border-radius:6px;
  border:1px solid #ddd;
}

.bookCoverPlaceholder{
  width:50px;
  height:70px;
  display:flex;
  align-items:center;
  justify-content:center;
  background:#f2f2f2;
  border-radius:6px;
  border:1px solid #ddd;
}
/* ==================================================
   END
================================================== */
